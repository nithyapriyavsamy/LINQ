.idea/
*.DotSettings.user

# Ignore Rider IDE files
/.idea/
/*.sln.iml

# Ignore other system files
.DS_Store
Thumbs.db

# Ignore generated files
Generated/

# Ignore JetBrains Rider / Resharper folders
**/.idea/
**/.vsconfig

# Ignore Test results
TestResults/
*.TestResults/

# Ignore Code Coverage results
*.coverage
*.coveragexml
*.coveragejson