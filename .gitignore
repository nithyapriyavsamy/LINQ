# Ignore Visual Studio-specific files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore build outputs
bin/
obj/
*.exe
*.dll
*.pdb

# Ignore NuGet packages
packages/
*.nupkg
project.lock.json
project.assets.json

# Ignore user settings
*.config
*.csproj.user
appsettings*.json

# Ignore logs and temp files
logs/
*.log
*.tmp

